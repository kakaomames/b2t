    <ps name="A64.control.testfault.TFLTNZ" sections="1" secttype="Operation">
      <pstext mayhavelinks="1" section="Execute" rep_section="execute"><a link="func_CheckCFLTEnabled_0" file="shared_pseudocode.xml">CheckCFLTEnabled</a>();

let operand : bits(datasize) = X{}(t);

if operand[bit_pos] != '0' then
    let isflt : boolean = FALSE;
    AArch64_ConditionalFault(isflt, reason);
end;</pstext></ps>
