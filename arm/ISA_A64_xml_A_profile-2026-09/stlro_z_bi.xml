if <a link="func_MaxImplementedVL_0" file="shared_pseudocode.xml">MaxImplementedVL</a>() &lt; 256 then <a link="func_EndOfDecode_1" file="shared_pseudocode.xml">EndOfDecode</a>(<a link="enum_Decode_UNDEF" file="shared_pseudocode.xml">Decode_UNDEF</a>); end;
