  <ps_section howmany="1">
    <ps name="A64.sve.sve_memst_cs.sve_mem_relspill.stlro_z_bi_" sections="1" secttype="Operation">
      <pstext mayhavelinks="1" section="Execute" rep_section="execute"><a link="func_CheckNonStreamingSVEEnabled_0" file="shared_pseudocode.xml">CheckNonStreamingSVEEnabled</a>();
let VL : integer{} = <a link="func_CurrentVL_0" file="shared_pseudocode.xml">CurrentVL</a>();
if VL &lt; 256 then <a link="func_EndOfDecode_1" file="shared_pseudocode.xml">EndOfDecode</a>(<a link="enum_Decode_UNDEF" file="shared_pseudocode.xml">Decode_UNDEF</a>); end;
var src : bits(VL);
var base : bits(64);
let offset : integer = imm * 32;
let tagchecked : boolean = n != 31;
let accdesc : <a link="type_AccessDescriptor" file="shared_pseudocode.xml">AccessDescriptor</a> = <a link="func_CreateAccDescAcqRel_4" file="shared_pseudocode.xml">CreateAccDescAcqRel</a>(<a link="enum_MemOp_STORE" file="shared_pseudocode.xml">MemOp_STORE</a>, tagchecked, acquire, t);

if n == 31 then
    <a link="func_CheckSPAlignment_0" file="shared_pseudocode.xml">CheckSPAlignment</a>();
    base = <a link="accessor_SP_1" file="shared_pseudocode.xml">SP</a>{64}();
else
    base = <a link="accessor_X_2" file="shared_pseudocode.xml">X</a>{64}(n);
end;

src = <a link="accessor_Z_2" file="shared_pseudocode.xml">Z</a>{VL}(t);
let data : bits(256) = src[0 +: 256];

let addr : bits(64) = <a link="func_AddressAdd_3" file="shared_pseudocode.xml">AddressAdd</a>(base, offset, accdesc);

<a link="accessor_Mem_3" file="shared_pseudocode.xml">Mem</a>{256}(addr, accdesc) = data;</pstext></ps>
