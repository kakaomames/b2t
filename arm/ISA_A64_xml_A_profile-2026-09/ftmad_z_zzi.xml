let VL : integer{} = <a link="func_CurrentVL_0" file="shared_pseudocode.xml">CurrentVL</a>();
let elements : integer = VL DIV esize;
let operand1 : bits(VL) = Z{}(dn);
let operand2 : bits(VL) = Z{}(m);
var result : bits(VL);

for e = 0 to elements-1 do
    let element1 : bits(esize) = operand1[e*:esize];
    let element2 : bits(esize) = operand2[e*:esize];
    result[e*:esize] = <a link="func_FPTrigMAdd_5" file="shared_pseudocode.xml">FPTrigMAdd</a>{esize}(imm, element1, element2, FPCR());
end;

