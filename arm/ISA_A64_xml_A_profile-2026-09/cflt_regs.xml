      <ps_section howmany="1">
        <ps name="A64.control.compfault_regs.CFLTGT_32_regs" sections="1" secttype="noheading">
          <pstext mayhavelinks="1" section="Decode" rep_section="decode">if !IsFeatureImplemented(FEAT_CFLT) then <a link="func_EndOfDecode_1" file="shared_pseudocode.xml">EndOfDecode</a>(<a link="enum_Decode_UNDEF" file="shared_pseudocode.xml">Decode_UNDEF</a>); end;

let datasize : integer{} = 32 &lt;&lt; UInt(sf);
let t : integer = UInt(Rt);
let m : integer = UInt(Rm);
let reason : bits(16) = ZeroExtend{}(imm2);

var cmp : <a link="type_CmpOp" file="shared_pseudocode.xml">CmpOp</a>;
var unsigned : boolean;

case cc of
    when '000' =&gt; cmp = <a link="enum_Cmp_GT" file="shared_pseudocode.xml">Cmp_GT</a>; unsigned = FALSE;
    when '001' =&gt; cmp = <a link="enum_Cmp_GE" file="shared_pseudocode.xml">Cmp_GE</a>; unsigned = FALSE;
    when '010' =&gt; cmp = <a link="enum_Cmp_GT" file="shared_pseudocode.xml">Cmp_GT</a>; unsigned = TRUE;
    when '011' =&gt; cmp = <a link="enum_Cmp_GE" file="shared_pseudocode.xml">Cmp_GE</a>; unsigned = TRUE;
    when '110' =&gt; cmp = <a link="enum_Cmp_EQ" file="shared_pseudocode.xml">Cmp_EQ</a>; unsigned = TRUE;
    when '111' =&gt; cmp = <a link="enum_Cmp_NE" file="shared_pseudocode.xml">Cmp_NE</a>; unsigned = TRUE;
    otherwise  =&gt; <a link="func_EndOfDecode_1" file="shared_pseudocode.xml">EndOfDecode</a>(<a link="enum_Decode_UNDEF" file="shared_pseudocode.xml">Decode_UNDEF</a>);
end;</pstext></ps>
